{
  "name": "opa-integration-layer",
  "version": "1.0.0",
  "description": "ARE-A-S1-001 OPA Integration Layer",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
